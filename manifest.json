{
  "manifest_version": 3,
  "name": "电商图片提取下载",
  "version": "1.0.0",
  "description": "在淘宝、京东、拼多多商家版商品详情页一键提取商品图片，并批量下载为 PNG",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.jd.com/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*",
    "*://*.alicdn.com/*",
    "*://*.tbcdn.cn/*",
    "*://*.360buyimg.com/*",
    "*://*.pddpic.com/*",
    "*://*.ddimg.jd.com/*",
    "https://img10.360buyimg.com/*",
    "https://img11.360buyimg.com/*",
    "https://img12.360buyimg.com/*",
    "https://img13.360buyimg.com/*",
    "https://img14.360buyimg.com/*",
    "https://img20.360buyimg.com/*",
    "https://img30.360buyimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "电商图片提取下载",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["gallery.html", "gallery.css", "gallery.js"],
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ]
    }
  ]
}
